{
  "name": "@inttegro/cogni-astro",
  "version": "0.0.0",
  "description": "Astro route adapters for Cogni predictive loading",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./CogniProvider.astro": "./src/components/CogniProvider.astro",
    "./PredictiveLink.astro": "./src/components/PredictiveLink.astro"
  },
  "files": [
    "dist",
    "src/components",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && astro check",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check src tests *.json *.md *.ts",
    "test": "vitest run",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests",
    "typecheck:source": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "prefetch",
    "predictive-loading",
    "performance",
    "astro"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/cogni.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/inttegro/cogni/issues"
  },
  "homepage": "https://github.com/inttegro/cogni#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@inttegro/cogni-client": "0.0.0"
  },
  "peerDependencies": {
    "astro": ">=5 <8"
  }
}
