{
  "name": "@inttegro/cogni-server",
  "version": "0.2.0",
  "description": "Node.js server runtime for the Cogni backend protocol",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check src tests *.json *.md",
    "test": "vitest run",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests",
    "typecheck:source": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "prefetch",
    "predictive-loading",
    "performance",
    "typescript",
    "node"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inttegro/cogni.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/inttegro/cogni/issues"
  },
  "homepage": "https://github.com/inttegro/cogni#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
