{
  "name": "@inttegro/cogni-devtools",
  "version": "0.2.0",
  "description": "Embedded and browser DevTools for Cogni predictive loading",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "INTER-LICENSE.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check src tests *.json *.md *.ts",
    "test": "vitest run",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests",
    "typecheck:source": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "devtools",
    "prefetch",
    "predictive-loading",
    "performance",
    "react"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inttegro/cogni.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/inttegro/cogni/issues"
  },
  "homepage": "https://github.com/inttegro/cogni#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@inttegro/cogni-client": "0.2.0"
  },
  "peerDependencies": {
    "@inttegro/cogni-react": "0.2.0",
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "@inttegro/cogni-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
