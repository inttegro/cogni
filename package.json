{
  "name": "@inttegro/cogni-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for Cogni predictive loading packages",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run verify:package",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "test": "npm run test:workspaces && npm run test:integration",
    "test:integration": "vitest run tests/client-server.test.ts",
    "test:workspaces": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:integration",
    "typecheck:integration": "tsc --project tsconfig.integration.json --noEmit",
    "verify:package": "tsc --project tests/tsconfig.package.json --noEmit"
  },
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/cogni.git"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
