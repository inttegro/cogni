{
  "name": "@inttegro/cogni",
  "version": "0.0.0",
  "description": "Predictive loading coordinator and TypeScript client",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    }
  },
  "files": [
    "dist",
    "protocol",
    "CHARTER.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/protocol.ts --format esm,cjs --dts --clean",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests",
    "typecheck:source": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "prefetch",
    "predictive-loading",
    "performance",
    "typescript",
    "protocol",
    "streaming"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/cogni.git"
  },
  "bugs": {
    "url": "https://github.com/inttegro/cogni/issues"
  },
  "homepage": "https://github.com/inttegro/cogni#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
