{
  "name": "@inttegro/cogni-browser-devtools",
  "version": "0.2.0",
  "private": true,
  "description": "Chromium and Firefox DevTools extension for Cogni",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check src tests scripts *.json *.md",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inttegro/cogni-devtools": "0.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2"
  }
}
