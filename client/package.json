{
  "name": "@inttegro/cogni-client",
  "version": "0.0.0",
  "description": "Browser and frontend runtime for Cogni predictive loading",
  "type": "module",
  "packageManager": "npm@11.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./chrome-ai": {
      "types": "./dist/chrome-ai.d.ts",
      "import": "./dist/chrome-ai.js",
      "require": "./dist/chrome-ai.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/protocol.ts src/browser.ts src/chrome-ai.ts --format esm,cjs --dts --clean",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check src tests *.json *.md",
    "test": "vitest run",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests",
    "typecheck:source": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "prefetch",
    "predictive-loading",
    "performance",
    "typescript",
    "browser"
  ],
  "author": "Inttegro Eng <engineering@inttegro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inttegro/cogni.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/inttegro/cogni/issues"
  },
  "homepage": "https://github.com/inttegro/cogni#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
